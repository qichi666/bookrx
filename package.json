{
  "name": "bookrx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:domain": "vitest run tests/domain",
    "catalog:audit": "node tools/catalog-audit.mjs",
    "audit:copyright": "node tools/copyright-audit.mjs",
    "audit:style": "node tools/style-audit.mjs",
    "budget:check": "node tools/budget-check.mjs",
    "check:enums": "node tools/check-enums.mjs",
    "check": "npm run typecheck && npm run test && npm run check:enums && npm run audit:style && npm run data:verify && npm run data:map-core",
    "check:data": "npm run catalog:audit && npm run audit:copyright && npm run budget:check",
    "prebuild": "node tools/assert-crisis-chunk-plan.mjs && node tools/map-core-to-candidates.mjs && node tools/gen-boot-data.mjs && node tools/build-candidates.mjs && node tools/verify-candidates.mjs && node tools/derive-annotations.mjs && node tools/verify-derived.mjs",
    "postbuild": "node tools/assert-crisis-chunk.mjs",
    "data:fetch": "node tools/fetch-douban.mjs --all --pages 25",
    "data:build": "node tools/build-candidates.mjs",
    "data:verify": "node tools/verify-candidates.mjs && node tools/verify-derived.mjs",
    "data:derive": "node tools/derive-annotations.mjs",
    "data:map-core": "node tools/map-core-to-candidates.mjs",
    "data:boot": "node tools/gen-boot-data.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.3",
    "pinyin-pro": "^3.29.5",
    "typescript": "~5.7.3",
    "vite": "^6.0.11",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
